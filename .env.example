# Copy this file to .env and fill in values for your machine. Never commit .env.
# Config files can reference these as ${NAME} or ${NAME:-default}.

# URL of the self-hosted WebArena shopping site (for the WebArena environment).
WEBARENA_SHOPPING_URL=http://localhost:7770

# Hugging Face token, only needed for gated models or private adapters.
HF_TOKEN=

# Where rollout runs and model checkpoints are written.
RUNS_DIR=runs
CHECKPOINT_DIR=checkpoints

# Optional: Hugging Face cache location (e.g. a larger scratch disk on the GPU machine).
HF_HOME=
