# Settings for scripts/gcp/vm.sh. Shared defaults: edit here to change them for everyone.
#
# Put personal settings (at least PROJECT) in scripts/gcp/config.local.env, which git ignores:
#     PROJECT=my-team-project-id
# Anything can also be set for one command: ZONE=us-east4-a scripts/gcp/vm.sh create
# Precedence: command-line environment > config.local.env > this file.

# GCP project to create the VM in. Required, and deliberately has no default, so the VM never
# lands in whatever project gcloud happens to be pointing at.
: "${PROJECT:=}"

# L4s are offered in us-central1-a/b/c, us-east4-a/c, us-west1-a/b and others. If a create
# fails for lack of capacity, try another zone.
: "${ZONE:=us-central1-a}"
: "${VM_NAME:=browser-agent-gpu}"

# g2-standard-8 = 8 vCPU, 32 GB RAM, 1x NVIDIA L4 (24 GB, supports bf16). The GPU comes with
# the machine type, so GPU_TYPE stays empty.
# Cheaper, smaller alternative: MACHINE_TYPE=n1-standard-8 GPU_TYPE=nvidia-tesla-t4
# (16 GB, no bf16).
: "${MACHINE_TYPE:=g2-standard-8}"
: "${GPU_TYPE:=}"
: "${GPU_COUNT:=1}"

# The Deep Learning VM image ships with CUDA and installs the NVIDIA driver on first boot.
# Empty = the newest Ubuntu "common-cu*" image family at create time.
: "${IMAGE_FAMILY:=}"
: "${DISK_GB:=150}"

# true = Spot VM: roughly 60-70% cheaper, but Google can stop it at any time. Fine for the
# pilot and short jobs; long training runs need checkpointing first.
: "${SPOT:=false}"

# Safety net: the VM stops itself this many hours after each start, so a forgotten VM doesn't
# burn credits. 0 = never. Raise it for long training runs.
: "${MAX_RUN_HOURS:=8}"

# Code the VM checks out. Empty = the branch you're on locally (it must be pushed).
: "${REPO_URL:=https://github.com/jasmineztruong8/browser-control.git}"
: "${BRANCH:=}"
